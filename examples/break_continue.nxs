// Exemplo de uso de break e continue no Nexus.
// Execute com:
//   java -cp target/classes org.example.Nexus examples/break_continue.nxs

// break interrompe o laço imediatamente.
print "break:";
var i = 0;
while (true) {
  if (i == 3) break;
  print i;                 // 0, 1, 2
  i = i + 1;
}

// continue pula para a proxima iteracao.
// Em um for, o incremento ainda e executado, entao nao ha loop infinito.
print "continue:";
for (var j = 0; j < 5; j = j + 1) {
  if (j == 2) continue;    // pula o 2
  print j;                 // 0, 1, 3, 4
}

// break afeta apenas o laco mais interno.
print "aninhado:";
for (var a = 1; a <= 3; a = a + 1) {
  for (var b = 1; b <= 3; b = b + 1) {
    if (b == 2) break;     // sai so do laco interno
    print a;               // 1, 2, 3
  }
}
