// Exemplo de uso de listas no Nexus.
// Execute com:
//   java -cp target/classes org.example.Nexus examples/lists.nxs

// Literal de lista e impressão.
var frutas = ["maçã", "banana", "uva"];
print frutas;              // [maçã, banana, uva]

// Acesso por índice (base 0).
print frutas[0];           // maçã
print frutas[2];           // uva

// Atribuição por índice.
frutas[1] = "manga";
print frutas;              // [maçã, manga, uva]

// Tamanho com a função nativa len (serve para listas e strings).
print len(frutas);         // 3
print len("nexus");        // 5

// append adiciona ao fim (muta a lista).
append(frutas, "pêra");
print frutas;              // [maçã, manga, uva, pêra]

// remove retira pelo índice e devolve o elemento removido.
var removida = remove(frutas, 0);
print removida;            // maçã
print frutas;              // [manga, uva, pêra]

// Listas podem conter qualquer valor, inclusive outras listas.
var matriz = [[1, 2], [3, 4]];
print matriz[1][0];        // 3

// Percorrendo uma lista com um laço.
fun soma(lista) {
  var total = 0;
  for (var i = 0; i < len(lista); i = i + 1) {
    total = total + lista[i];
  }
  return total;
}
print soma([10, 20, 30]);  // 60
